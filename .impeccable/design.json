      "css": ".ds-field-label{display:block;font-family:var(--sans);font-size:12px;line-height:1.5;font-weight:600;color:var(--text);margin:16px 0 6px;}.ds-field{min-width:0;width:100%;min-height:42px;padding:9px 12px;background:var(--input);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--text);font-family:var(--sans);font-size:13px;line-height:1.5;caret-color:var(--coral);}.ds-field:hover{border-color:#71849d;}.ds-field::placeholder{color:var(--muted);opacity:1;}.ds-field:focus-visible{outline:2px solid var(--apricot);outline-offset:3px;}"
