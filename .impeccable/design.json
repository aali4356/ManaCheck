      "description": "One card name, a concise reason and the add action; shared caveat stays at section level.",
      "html": "<article class=\"ds-suggestion\"><h3 class=\"ds-suggestion-title\">Cultivate</h3><p class=\"ds-suggestion-reason\">Adds ramp for the saved deck.</p><button class=\"ds-button-primary\" type=\"button\">Add to deck</button></article>",
      "css": ".ds-suggestion{padding:20px;border-radius:var(--radius-panel);background:var(--panel);color:var(--text);display:flex;flex-direction:column;align-items:start;gap:10px;min-width:0;font-family:var(--sans);line-height:1.5;}.ds-suggestion-title{margin:0;font-size:16px;font-weight:650;line-height:1.4;overflow-wrap:anywhere;}.ds-suggestion-reason{margin:0;color:var(--muted);font-size:12px;max-width:70ch;}.ds-suggestion .ds-button-primary{margin-top:auto;}.ds-button-primary{display:inline-flex;justify-content:center;align-items:center;gap:8px;min-height:40px;padding:9px 15px;border:1px solid transparent;border-radius:var(--radius-sm);font-family:var(--sans);font-size:13px;line-height:20px;font-weight:650;white-space:nowrap;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out;background:var(--coral);color:var(--input);}.ds-button-primary:hover{background:var(--coral-hover);color:var(--input);}.ds-button-primary:active{background:var(--apricot);}.ds-button-primary:disabled{cursor:default;background:var(--panel);border-color:var(--line);color:var(--muted);}.ds-button-primary[data-busy]{cursor:progress;border-color:var(--apricot);}.ds-button-primary:focus-visible{outline:2px solid var(--apricot);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;animation:none!important;scroll-behavior:auto!important;}}"
    },
    {
      "name": "Deck entry",
      "kind": "custom",
      "refersTo": "deck-entry",
      "description": "Aligned card identity, mana value, quantity and inline SVG remove control.",
      "html": "<div class=\"ds-entry\"><div class=\"ds-card-info\"><span class=\"ds-card-name\">Cultivate</span><span class=\"ds-card-type\">Sorcery</span></div><span class=\"ds-mana\">3</span><input class=\"ds-quantity\" type=\"number\" min=\"1\" value=\"1\" aria-label=\"Cultivate quantity\"><button type=\"button\" class=\"ds-remove\" aria-label=\"Remove Cultivate\"><svg class=\"ds-remove-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M6 18 18 6\"/></svg></button></div>",
      "css": ".ds-entry{display:grid;grid-template-columns:minmax(0,1fr) 24px 50px 30px;gap:10px;align-items:center;padding:10px 4px 10px 8px;min-height:60px;border-bottom:1px solid var(--line);color:var(--text);font-family:var(--sans);line-height:1.5;}.ds-entry:hover{background:var(--panel);}.ds-card-info{min-width:0;}.ds-card-name{display:block;font-size:13px;font-weight:500;overflow-wrap:anywhere;}.ds-card-type{font-size:11px;display:block;margin-top:2px;color:var(--muted);}.ds-mana{text-align:center;color:var(--apricot);font-size:12px;font-variant-numeric:tabular-nums;}.ds-quantity{min-width:0;width:100%;min-height:34px;padding:5px 3px;text-align:center;background:var(--input);border:1px solid var(--line);border-radius:var(--radius-sm);color:var(--text);font-family:var(--sans);font-size:12px;line-height:1.5;caret-color:var(--coral);}.ds-quantity:hover{border-color:#71849d;}.ds-remove{width:30px;height:36px;display:grid;place-items:center;border:0;border-radius:var(--radius-sm);background:transparent;color:var(--muted);cursor:pointer;}.ds-remove:hover{background:var(--surface-hover);color:var(--danger);}.ds-remove-icon{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}.ds-quantity:focus-visible{outline:2px solid var(--apricot);outline-offset:3px;}.ds-remove:focus-visible{outline:2px solid var(--apricot);outline-offset:3px;}@media(max-width:680px){.ds-entry{gap:8px;grid-template-columns:minmax(0,1fr) 20px 45px 26px;padding-left:0;}.ds-remove{width:26px;}.ds-card-name{font-size:12px;}.ds-card-type{font-size:10px;}}"
    },
    {
      "name": "Analysis role coverage",
      "kind": "custom",
      "refersTo": "analysis-panel",
      "description": "Panel tone, numeric coverage and native progress; illustrative values only.",
      "html": "<section class=\"ds-analysis\" aria-label=\"Analysis\"><h2 class=\"ds-analysis-title\">Analysis</h2><div class=\"ds-role\"><span>Ramp</span><span>6 / 10</span><progress class=\"ds-role-progress\" value=\"6\" max=\"10\" aria-label=\"Ramp: 6 of target 10\"></progress></div></section>",
      "css": ".ds-analysis{padding:20px;background:var(--panel);border-radius:var(--radius-panel);min-width:0;color:var(--text);font-family:var(--sans);line-height:1.5;}.ds-analysis-title{margin:0;font-size:16px;font-weight:650;line-height:1.4;}.ds-role{display:grid;grid-template-columns:1fr auto;gap:6px;font-size:12px;text-transform:capitalize;margin-top:12px;}.ds-role>span:last-of-type{font-variant-numeric:tabular-nums;font-size:11px;}.ds-role-progress{grid-column:1/-1;width:100%;height:5px;appearance:none;border:0;border-radius:3px;overflow:hidden;background:var(--line);}.ds-role-progress::-webkit-progress-bar{background:var(--line);}.ds-role-progress::-webkit-progress-value{background:var(--apricot);}.ds-role-progress::-moz-progress-bar{background:var(--apricot);}"
    }
